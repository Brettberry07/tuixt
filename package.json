{
  "name": "tuixt",
  "version": "1.0.0",
  "description": "Terminal-based, cloud-backed notes and kanban application",
  "main": "dist/index.js",
  "bin": {
    "tuixt": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
